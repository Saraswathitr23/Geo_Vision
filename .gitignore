# =========================================================
# GeoVision - Git Ignore
# =========================================================

# -------------------------
# Logs
# -------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
dist/
dist-ssr/
.vite/
.cache/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

# -------------------------
# Environment Variables
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Backend Generated Cache
# -------------------------
backend/cache/

# -------------------------
# Database
# -------------------------
*.db
*.sqlite
*.sqlite3

backend/database.db

# -------------------------
# Generated Reports
# -------------------------
backend/report.csv

# -------------------------
# Uploaded Files
# -------------------------
uploads/
backend/uploads/

# -------------------------
# Machine Learning Models
# -------------------------
# Ignore large trained model files
*.h5
*.hdf5
*.pt
*.pth
*.pkl
*.joblib

# -------------------------
# ML / Training Outputs
# -------------------------
backend/models/
backend/training/
backend/checkpoints/

# -------------------------
# OS Files
# -------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# -------------------------
# IDE / Editors
# -------------------------
.vscode/*
!.vscode/extensions.json

.idea/
*.iml

# -------------------------
# Python Tools
# -------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# -------------------------
# Build / Temporary Files
# -------------------------
build/
*.tmp
*.temp
*.bak
*.swp
*.swo

# -------------------------
# Coverage
# -------------------------
coverage/
.nyc_output/

# -------------------------
# TypeScript
# -------------------------
*.tsbuildinfo

# -------------------------
# Environment / Local Config
# -------------------------
*.local

# -------------------------
# Backup Files
# -------------------------
*~
*.orig
*.rej